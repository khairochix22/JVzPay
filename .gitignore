# Secrets: .env holds the database password, session secret and DATA_ENCRYPTION_KEY. Never commit it; share .env.example instead.
.env
.env.*
!.env.example

# Personal data and backups live outside version control
storage/
*.sql
*.sql.gz
# ...except the schema migrations: a fresh copy needs them to build the database (npm run migrate)
!database/migrations/*.sql

# Dependencies and machine files
node_modules/
npm-debug.log*
*.log
.DS_Store
Thumbs.db
