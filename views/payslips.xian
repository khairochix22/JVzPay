{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>Payslips</h1><p>Generated when payroll is finalized; visible to employees once released.</p></div></div>
<section class="card">
  <form class="toolbar" method="GET" action="/payroll/payslips"><div class="input-group search"><svg class="ic"><use href="#i-search"/></svg><label class="sr-only" for="q">Search</label><input class="input" type="search" id="q" name="q" value="{{t.q}}" placeholder="Employee or payslip no." data-autosubmit></div>
    <select class="select" name="period" aria-label="Period" data-autosubmit><option value="">All periods</option>{{#each periods}}<option value="{{id}}" {{selected id ../period}}>{{label}}</option>{{/each}}</select></form>
  {{#if rows.length}}
  <div class="table-wrap"><table class="table table--stack">
    <thead><tr>{{sortTh meta "employee" "Employee"}}<th>Payslip</th>{{sortTh meta "period" "Period"}}<th class="text-right">Gross</th>{{sortTh meta "net" "Net"}}<th>Status</th><th class="actions"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>{{#each rows}}<tr>
      <td class="cell-primary"><strong>{{employee_name}}</strong><br><span class="muted">{{employee_no}} · {{department_name}}</span></td>
      <td data-label="Payslip">{{payslip_no}}</td>
      <td data-label="Period">{{period_label}}</td>
      <td data-label="Gross" class="text-right num">{{money gross_pay}}</td>
      <td data-label="Net" class="text-right num"><strong>{{money net_pay}}</strong></td>
      <td data-label="Status">{{#if (eq record_status "voided")}}{{badge "voided"}}{{else}}{{badge status}}{{/if}}</td>
      <td class="actions"><a class="btn btn--secondary btn--sm" href="/payroll/payslips/{{id}}">View</a> <a class="btn btn--ghost btn--sm" href="/payroll/payslips/{{id}}/pdf">PDF</a></td>
    </tr>{{/each}}</tbody>
  </table></div>
  {{> pager meta=meta}}
  {{else}}<div class="empty"><svg class="ic"><use href="#i-file-text"/></svg><strong>No payslips yet</strong>Payslips are generated when a payroll batch is finalized.</div>{{/if}}
</section>
{{> app_shell_close}}
