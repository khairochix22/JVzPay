{{> app_head}}
<div class="auth">
  {{#> auth_hero headline="Join JVzPay Today!" lead="Streamline your accounting work. Ask for an account with the details HR keeps about you."}}
  <ul class="auth__points auth__points--check">
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-check"/></svg></span><span>Record income and expenses</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-check"/></svg></span><span>Prepare entries for approval</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-check"/></svg></span><span>Generate financial reports</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-check"/></svg></span><span>Every request is approved by the Accounting Supervisor</span></li>
  </ul>
  {{/auth_hero}}

  <main class="auth__panel">
    <div class="auth__card">
      <div class="auth__mobile-brand"><img class="auth__logo" src="/img/johnvivz-logo-trim.png" alt="JohnVivz" width="120" height="65"><span>JVzPay<small>Manage · Pay · Grow</small></span></div>
      {{#if sent}}
      <div class="auth__head"><h1>Request sent</h1></div>
      <div class="alert alert--success" role="status"><svg class="ic"><use href="#i-check-circle"/></svg><div>Your request is waiting for the Accounting Supervisor. Once it is approved, sign in with the email and password you just chose.</div></div>
      <a class="btn btn--primary btn--block" href="/login">Back to sign in</a>
      {{else}}
      <div class="auth__head auth__head--left">
        <h1>Create Your Account</h1>
        <p>For accounting staff of {{company.name}}. Get started in just a few steps.</p>
      </div>
      {{#unless hrConnected}}<div class="alert alert--info"><svg class="ic"><use href="#i-alert"/></svg><div>The HR system is not connected yet, so your details cannot be checked automatically. The Accounting Supervisor will review your request.</div></div>{{/unless}}
      {{#if errors.form}}<div class="alert alert--error" role="alert"><svg class="ic"><use href="#i-alert"/></svg><div>{{errors.form}}</div></div>{{/if}}

      <form method="POST" action="/register" novalidate>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="form-grid">
          {{> field fieldIcon="user" name="full_name" label="Full name" required=true value=form.full_name error=errors.full_name autocomplete="name" placeholder="As it appears in HR records"}}
          {{> field fieldIcon="hash" name="employee_no" label="Employee ID" required=true value=form.employee_no error=errors.employee_no autocomplete="off" placeholder="e.g. JV-0012"}}
          <div class="field">
            <label for="department_id">Department <span class="req" aria-hidden="true">*</span></label>
            <div class="input-icon">
              <svg class="ic"><use href="#i-briefcase"/></svg>
              <select class="select" id="department_id" name="department_id" required>
                <option value="">Choose your department</option>
                {{#each departments}}<option value="{{id}}" {{selected ../form.department_id id}}>{{name}}</option>{{/each}}
              </select>
            </div>
            {{#if errors.department_id}}<span class="field__error" id="department_id-err">{{errors.department_id}}</span>{{/if}}
          </div>
          <div class="field">
            <label for="position_title">Position <span class="req" aria-hidden="true">*</span></label>
            <div class="input-icon">
              <svg class="ic"><use href="#i-user"/></svg>
              <select class="select" id="position_title" name="position_title" required>
                <option value="">Choose your position</option>
                {{#each positions}}<option value="{{title}}" data-department-id="{{department_id}}" {{selected ../form.position_title title}}>{{title}}</option>{{/each}}
              </select>
            </div>
            {{#if errors.position_title}}<span class="field__error" id="position_title-err">{{errors.position_title}}</span>{{/if}}
          </div>
          {{> field fieldIcon="key" name="hr_code" label="Unique code from HR" required=true value=form.hr_code error=errors.hr_code autocomplete="off"}}
          {{> field fieldIcon="mail" name="email" label="Email address" type="email" required=true value=form.email error=errors.email autocomplete="email" inputmode="email"}}
          {{> field fieldIcon="lock" reveal=true name="password" label="Password" type="password" required=true error=errors.password autocomplete="new-password" hint="At least 10 characters, with letters and numbers."}}
          {{> field fieldIcon="lock" reveal=true name="confirm_password" label="Confirm password" type="password" required=true error=errors.confirm_password autocomplete="new-password"}}
          <div class="field"><label class="check check--sm"><input type="checkbox" name="privacy_ack" value="1"> <span>I have read the <a href="/privacy" target="_blank" rel="noopener">Privacy Notice</a> and understand how my information is used.</span></label>{{#if errors.privacy_ack}}<span class="field__error">{{errors.privacy_ack}}</span>{{/if}}</div>
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg" style="margin-top:20px"><svg class="ic"><use href="#i-user-plus"/></svg>Send request</button>
      </form>
      <p class="auth__alt">Already have an account? <a href="/login">Sign in</a> · <a href="/privacy">Privacy Notice</a></p>
      {{/if}}
    </div>
  </main>
</div>
<script src="/js/register.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
