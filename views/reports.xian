{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>Reports</h1><p>View any report on screen, or export it to PDF or Excel. Exports are recorded in the audit log.</p></div></div>
{{#each groups}}
<section class="card mb"><div class="card__header"><h2>{{name}}</h2></div>
  <div class="card__body"><div class="quick">{{#each items}}<a href="/reports/{{key}}"><svg class="ic"><use href="#i-file-text"/></svg>{{title}}</a>{{/each}}</div></div></section>
{{else}}<section class="card"><div class="empty"><svg class="ic"><use href="#i-file-text"/></svg><strong>No reports available</strong>Your role has no report access.</div></section>{{/each}}
{{> app_shell_close}}
