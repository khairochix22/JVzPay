{{> app_head}}
{{> app_shell_open}}
<div class="page-header">
  <div><h1>My Payslips</h1><p>Official payslips appear here once payroll for the period has been finalized and released.</p></div>
</div>

{{#if rows.length}}
<section class="card mb">
  <div class="card__header"><div><h2>Latest payslip</h2><p>{{rows.0.period_label}}</p></div></div>
  <div class="card__body">
    <div class="tile-grid">
      <div><div class="kpi__label">Gross pay</div><div class="tile__value">{{money rows.0.gross_pay}}</div></div>
      <div><div class="kpi__label">Total deductions</div><div class="tile__value">{{money rows.0.total_deductions}}</div></div>
      <div><div class="kpi__label">Net pay</div><div class="tile__value" style="color:var(--success-ink)">{{money rows.0.net_pay}}</div></div>
    </div>
    <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
      <a class="btn btn--primary" href="/my/payslips/{{rows.0.id}}">View details</a>
      <a class="btn btn--secondary" href="/my/payslips/{{rows.0.id}}/pdf"><svg class="ic"><use href="#i-download"/></svg>Download PDF</a>
    </div>
  </div>
</section>

<section class="card">
  <div class="card__header"><h2>All payslips</h2></div>
  <div class="card__body card__body--flush" style="padding-top:8px">
    <div class="table-wrap"><table data-table-tools class="table table--stack">
      <thead><tr><th>Payroll period</th><th>Pay date</th><th class="text-right">Gross</th><th class="text-right">Deductions</th><th class="text-right">Net pay</th><th class="actions"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td class="cell-primary"><strong>{{period_label}}</strong><br><span class="muted">{{date start_date}} – {{date end_date}} · {{payslip_no}}</span></td>
          <td data-label="Pay date">{{date pay_date}}</td>
          <td data-label="Gross" class="text-right num">{{money gross_pay}}</td>
          <td data-label="Deductions" class="text-right num">{{money total_deductions}}</td>
          <td data-label="Net pay" class="text-right num"><strong>{{money net_pay}}</strong></td>
          <td class="actions"><a class="btn btn--secondary btn--sm" href="/my/payslips/{{id}}">View</a> <a class="btn btn--ghost btn--sm" href="/my/payslips/{{id}}/pdf" aria-label="Download PDF for {{period_label}}"><svg class="ic ic--sm"><use href="#i-download"/></svg>PDF</a></td>
        </tr>
        {{/each}}
      </tbody>
    </table></div>
  </div>
</section>
{{else}}
<section class="card"><div class="empty" style="padding:56px 20px"><svg class="ic"><use href="#i-file-text"/></svg><strong>No payslips yet</strong>Your payslip will be available here after payroll for your first period is approved, finalized and released. You will get a notification when it is ready.</div></section>
{{/if}}
{{> app_shell_close}}
