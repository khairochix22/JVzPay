{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>System Settings</h1><p>Attendance, payroll, leave and company configuration. Changes apply to future computations and are recorded in the audit log.</p></div></div>
<form method="POST" action="/settings" novalidate data-confirm="Save these settings? They affect future payroll computations." data-confirm-label="Save settings">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  {{#each groups}}
  <section class="card mb"><div class="card__header"><h2>{{humanize name}}</h2></div><div class="card__body"><div class="form-grid">
    {{#each items}}
    <div class="field">
      {{#if isBool}}<span class="label">{{description}}</span><label class="check"><input type="checkbox" name="{{field}}" value="1" {{#if isOn}}checked{{/if}}> Enabled</label>
      {{else if isSchedule}}<label for="{{field}}">How monthly contributions are deducted</label><select class="select" id="{{field}}" name="{{field}}"><option value="split" {{selected setting_value "split"}}>Split across the month's periods</option><option value="last" {{selected setting_value "last"}}>Deduct in the last period of the month</option></select>
      {{else if isTime}}<label for="{{field}}">{{description}}</label><input class="input" type="time" id="{{field}}" name="{{field}}" value="{{setting_value}}">
      {{else if isNumber}}<label for="{{field}}">{{description}}</label><input class="input" id="{{field}}" name="{{field}}" value="{{setting_value}}" inputmode="decimal">
      {{else}}<label for="{{field}}">{{description}}</label><input class="input" id="{{field}}" name="{{field}}" value="{{setting_value}}">{{/if}}
    </div>
    {{/each}}
  </div></div></section>
  {{/each}}
  <div class="form-actions" style="border-top:0"><button class="btn btn--primary" type="submit">Save settings</button></div>
</form>
{{> app_shell_close}}
