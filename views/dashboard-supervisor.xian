{{> app_head}}
{{> app_shell_open}}
<section class="welcome">
  <div><h1>Welcome back, {{welcomeName}}</h1><p>How {{company.name}}'s books and payroll stand today. Every figure is read live from posted records.</p></div>
  <div class="welcome__meta"><strong>{{me.roleName}}</strong>{{datetime generatedAt}}</div>
</section>

{{> announcements items=d.announcements}}

<div class="grid grid--kpi">
  {{#each d.kpis}}{{> kpi}}{{/each}}
</div>

<div class="grid grid--2 mb">
  {{> chart_card title="Financial performance" subtitle="Revenue and expenses, last 6 months · from posted journal entries" config=d.cfg.performance emptyText="Revenue and expenses appear here once journals are posted."}}
  {{> chart_card title="Cash flow" subtitle="Net change in cash and bank accounts, last 6 months" config=d.cfg.cashFlow emptyText="Cash movements appear here once journals are posted."}}
</div>

<div class="grid grid--main-side">
  <div>
    {{> chart_card title="Payroll expense" subtitle="Last 6 months · finalized and released payroll only" config=d.cfg.payroll emptyText="Payroll cost appears here once a batch is finalized."}}
    <section class="card" style="margin-top:22px">
      <div class="card__header"><div><h2>Quick actions</h2></div></div>
      <div class="card__body"><div class="quick">
        <a href="/accounting/approvals"><svg class="ic"><use href="#i-check-circle"/></svg>Accounting approvals</a>
        <a href="/payroll/batches?status=for_review"><svg class="ic"><use href="#i-wallet"/></svg>Review payroll</a>
        <a href="/reports/income-statement"><svg class="ic"><use href="#i-file-text"/></svg>Income statement</a>
        <a href="/reports/balance-sheet"><svg class="ic"><use href="#i-calculator"/></svg>Balance sheet</a>
        <a href="/analytics"><svg class="ic"><use href="#i-bar-chart"/></svg>Financial analytics</a>
        <a href="/users"><svg class="ic"><use href="#i-key"/></svg>User accounts</a>
        <a href="/audit"><svg class="ic"><use href="#i-shield"/></svg>Audit trail</a>
        <a href="/settings/backup"><svg class="ic"><use href="#i-download"/></svg>Backups</a>
      </div></div>
    </section>
  </div>
  {{> activity_list title="Recent activity" subtitle="Latest audited actions" items=d.activity}}
</div>

{{> dashboard_panels p=panels}}
<script src="/vendor/chartjs/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>
{{> app_shell_close}}
