{{> app_head}}
{{> app_shell_open}}
<div class="page-header">
  <div><h1>Vacation Leave Conversions</h1><p>Year-end cash conversion of unused vacation leave (up to 10 days a year). Approved conversions are paid as a non-taxable earning in each employee's next payroll.</p></div>
</div>

<nav class="page-actions mb" aria-label="Filter">
  {{#each (array "pending" "approved" "paid" "rejected" "all")}}<a class="btn {{#if (eq this ../status)}}btn--primary{{else}}btn--secondary{{/if}} btn--sm" href="/payroll/leave-conversions?status={{this}}">{{humanize this}}</a>{{/each}}
</nav>

<section class="card">
  <div class="card__body card__body--flush">
    {{#if rows.length}}<div class="table-wrap"><table class="table table--stack"><thead><tr><th>Employee</th><th>Request</th><th class="text-right">Days × rate</th><th class="text-right">Amount</th><th>Status</th><th class="actions"><span class="sr-only">Decision</span></th></tr></thead><tbody>
    {{#each rows}}<tr><td class="cell-primary"><strong>{{name}}</strong><br><span class="muted">{{employee_no}} · {{department}}</span></td>
      <td data-label="Request">{{conversion_no}}<br><span class="muted">VL {{year}} · {{date requested_at}}</span></td>
      <td data-label="Days × rate" class="text-right num">{{fixed days 1}} × {{money daily_rate}}</td>
      <td data-label="Amount" class="text-right num"><strong>{{money amount}}</strong></td>
      <td data-label="Status">{{badge status}}{{#if decided_by_name}}<br><span class="muted">by {{decided_by_name}}</span>{{/if}}{{#if decision_remarks}}<br><span class="muted">“{{decision_remarks}}”</span>{{/if}}</td>
      <td class="actions">{{#if (eq status "pending")}}{{#if (eq supervisor_status "pending")}}<span class="badge badge--warning">Waiting for {{default supervisor_name "the immediate supervisor"}}</span>{{else if (eq supervisor_decided_by @root.me.id)}}<span class="muted" style="font-size:12.5px">You gave the supervisor's approval</span>{{else}}{{> decide_inline action=(concat "/payroll/leave-conversions/" id "/decision") csrf=../csrfToken own=(eq employee_id @root.me.employeeId)}}{{#if (eq supervisor_status "approved")}}<div class="muted" style="font-size:12.5px">✓ Supervisor: {{supervisor_name}}</div>{{/if}}{{/if}}{{/if}}</td></tr>{{/each}}
    </tbody></table></div>
    {{else}}<div class="empty empty--sm"><svg class="ic"><use href="#i-wallet"/></svg><strong>No {{#unless (eq status "all")}}{{humanize status}} {{/unless}}conversions</strong></div>{{/if}}
  </div>
</section>
{{> app_shell_close}}
