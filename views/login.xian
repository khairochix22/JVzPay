{{> app_head}}
<div class="auth">
  {{#> auth_hero headline="Smart Accounting." headline2="Efficient Payroll." lead="A modern solution for managing payroll, attendance, leave and finances in one secure place."}}
  <ul class="auth__points">
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-shield"/></svg></span><span>Secure &amp; Reliable</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-check-circle"/></svg></span><span>Easy to Use</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-lock"/></svg></span><span>Compliant with RA 10173</span></li>
  </ul>
  {{/auth_hero}}

  <main class="auth__panel">
    <div class="auth__card">
      <div class="auth__mobile-brand"><img class="auth__logo" src="/img/johnvivz-logo-trim.png" alt="JohnVivz" width="120" height="65"><span>JVzPay<small>Manage · Pay · Grow</small></span></div>
      <div class="auth__head">
        <h1>Welcome Back!</h1>
        <p>Sign in to your JVzPay account</p>
      </div>

      {{#if expired}}<div class="alert alert--info" role="status"><svg class="ic"><use href="#i-clock"/></svg><div>You were signed out after {{idleMinutes}} minutes without activity. Sign in again to continue.</div></div>{{/if}}
      {{#if formError}}<div class="alert alert--error" role="alert"><svg class="ic"><use href="#i-alert"/></svg><div>{{formError}}</div></div>{{/if}}
      {{#each success_msg}}<div class="alert alert--success" role="status"><svg class="ic"><use href="#i-check-circle"/></svg><div>{{this}}</div></div>{{/each}}

      <form method="POST" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="field">
          <label for="email">Email address <span class="req" aria-hidden="true">*</span></label>
          <div class="input-icon"><svg class="ic"><use href="#i-mail"/></svg>
            <input class="input" type="email" id="email" name="email" value="{{email}}" autocomplete="username" inputmode="email" autofocus required placeholder="name@johnvivz.local">
          </div>
        </div>
        <div class="field" style="margin-top:16px">
          <label for="password">Password <span class="req" aria-hidden="true">*</span></label>
          <div class="input-icon input-icon--action"><svg class="ic"><use href="#i-lock"/></svg>
            <input class="input" type="password" id="password" name="password" autocomplete="current-password" required placeholder="Your password">
            <button type="button" class="input-icon__btn" data-toggle-password="password" aria-pressed="false" aria-label="Show password" data-no-loading><svg class="ic"><use href="#i-eye"/></svg></button>
          </div>
        </div>
        <div class="auth__row">
          <label class="check check--sm"><input type="checkbox" id="remember-email"> <span>Remember my email</span></label>
          <a href="/forgot-password">Forgot Password?</a>
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg">Sign In <svg class="ic"><use href="#i-arrow-right"/></svg></button>
      </form>
      <p class="auth__alt">New hire? <a href="/register/employee">Create your employee account</a><br>Accounting staff without an account? <a href="/register">Register here</a></p>
      <p class="auth__legal">Authorized use only. Activity is logged. Personal data is processed in line with the Data Privacy Act of 2012 · <a href="/privacy">Privacy Notice</a></p>
    </div>
  </main>
</div>
<script src="/js/app.js"></script>
</body>
</html>
