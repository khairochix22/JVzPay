{{> app_head}}
{{> app_shell_open}}
<div class="page-header">
  <div><h1>Account Requests</h1><p>Accounting staff who asked for an account with their employee name, ID, position and HR code.</p></div>
  <div class="page-actions"><a class="btn btn--secondary" href="/users"><svg class="ic"><use href="#i-key"/></svg>User accounts</a></div>
</div>
{{#unless hrConnected}}<div class="alert alert--warning"><svg class="ic"><use href="#i-alert"/></svg><div><strong>HR verification is pending.</strong> The HR system's database is not connected yet, so these details have not been checked against HR records. Confirm each person with HR before approving.</div></div>{{/unless}}
<section class="card">
  <form class="toolbar" method="GET" action="/users/requests" role="search">
    <div class="input-group search"><svg class="ic"><use href="#i-search"/></svg><label class="sr-only" for="q">Search requests</label>
      <input class="input" type="search" id="q" name="q" value="{{t.q}}" placeholder="Name, employee ID or email" data-autosubmit></div>
    <select class="select" name="status" aria-label="Status" data-autosubmit>{{#each (array "pending" "approved" "rejected" "all")}}<option value="{{this}}" {{selected this ../status}}>{{#if (eq this "all")}}All requests{{else}}{{humanize this}}{{/if}}</option>{{/each}}</select>
  </form>
  {{#if rows.length}}
  <div class="table-wrap"><table class="table table--stack">
    <thead><tr>{{sortTh meta "name" "Person"}}<th>Employee ID</th><th>Position</th><th>HR check</th>{{sortTh meta "submitted" "Requested"}}{{sortTh meta "status" "Status"}}<th class="actions"><span class="sr-only">Review</span></th></tr></thead>
    <tbody>{{#each rows}}<tr>
      <td class="cell-primary"><strong>{{full_name}}</strong><br><span class="muted">{{email}}</span></td>
      <td data-label="Employee ID" class="num">{{employee_no}}</td>
      <td data-label="Position">{{position_title}}</td>
      <td data-label="HR check">{{#if (eq hr_check "verified")}}{{badge "verified"}}{{else if (eq hr_check "not_found")}}<span class="badge badge--danger">Not found in HR</span>{{else}}<span class="badge badge--warning">Not checked</span>{{/if}}</td>
      <td data-label="Requested" class="nowrap">{{timeAgo created_at}}</td>
      <td data-label="Status">{{badge status}}</td>
      <td class="actions"><a class="btn {{#if (eq status "pending")}}btn--primary{{else}}btn--secondary{{/if}} btn--sm" href="/users/requests/{{id}}">{{#if (eq status "pending")}}Review{{else}}View{{/if}}</a></td>
    </tr>{{/each}}</tbody>
  </table></div>
  {{> pager meta=meta}}
  {{else}}<div class="empty"><svg class="ic"><use href="#i-inbox"/></svg><strong>No requests here</strong>{{#if (eq status "pending")}}Nobody is waiting for approval.{{else}}Try another status or search.{{/if}}</div>{{/if}}
</section>
{{> app_shell_close}}
