{{#if own}}<span class="muted" style="font-size:12.5px">Another supervisor must decide</span>
{{else}}
<form method="POST" action="{{action}}" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <input class="input" name="remarks" placeholder="Remarks (required to reject)" maxlength="255" style="min-height:36px;flex:1 1 140px" aria-label="Remarks">
  <button class="btn btn--primary btn--sm" type="submit" name="action" value="approve">{{default approveLabel "Approve"}}</button>
  <button class="btn btn--danger btn--sm" type="submit" name="action" value="reject">Reject</button>
</form>
{{/if}}
