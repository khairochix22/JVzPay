<div class="grid grid--3" style="margin-top:22px">
  <section class="card">
    <div class="card__header"><div><h2>Pending approvals</h2><p>Waiting for your action</p></div></div>
    <div class="card__body card__body--flush" style="padding-top:8px">
      {{#if p.queues.length}}<ul class="list">{{#each p.queues}}<li class="list__item"><span class="dot"></span><div class="list__body"><strong><a href="{{href}}">{{label}}</a></strong></div><span class="badge badge--warning">{{count}}</span></li>{{/each}}</ul>
      {{else}}<div class="empty empty--sm"><svg class="ic"><use href="#i-check-circle"/></svg><strong>Nothing waiting</strong>You're all caught up.</div>{{/if}}
    </div>
  </section>
  <section class="card">
    <div class="card__header"><div><h2>Recent payroll batches</h2></div></div>
    <div class="card__body card__body--flush" style="padding-top:8px">
      {{#if p.batches.length}}<div class="table-wrap"><table class="table"><tbody>{{#each p.batches}}<tr><td><a href="/payroll/batches/{{id}}"><strong>{{batch_no}}</strong></a><br><span class="muted" style="font-size:12.5px">{{period_label}}</span></td><td class="text-right num">{{money total_net}}<br>{{badge status}}</td></tr>{{/each}}</tbody></table></div>
      {{else}}<div class="empty empty--sm"><svg class="ic"><use href="#i-wallet"/></svg><strong>No payroll batches yet</strong></div>{{/if}}
    </div>
  </section>
  <section class="card">
    <div class="card__header"><div><h2>Notifications</h2></div><a class="btn btn--ghost btn--sm" href="/notifications">View all</a></div>
    <div class="card__body card__body--flush" style="padding-top:8px">
      {{#if p.notifications.length}}<ul class="list">{{#each p.notifications}}<li class="list__item {{#if is_read}}is-read{{/if}}"><span class="dot"></span><div class="list__body"><strong>{{title}}</strong><small>{{timeAgo created_at}}</small></div></li>{{/each}}</ul>
      {{else}}<div class="empty empty--sm"><svg class="ic"><use href="#i-bell"/></svg><strong>No notifications</strong></div>{{/if}}
    </div>
  </section>
</div>
