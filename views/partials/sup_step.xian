{{#if (eq supervisor_status "pending")}}<br><span class="badge badge--warning" title="The immediate supervisor approves first">Waiting for {{default supervisor_name "the immediate supervisor"}}{{#if (eq routed_to "department")}} (through HR){{/if}}</span>{{else if (eq supervisor_status "approved")}}<br><span class="muted" style="font-size:12.5px">✓ Supervisor: {{supervisor_name}}</span>{{else if (eq supervisor_status "rejected")}}<br><span class="muted" style="font-size:12.5px">Rejected by the supervisor{{#if supervisor_name}} ({{supervisor_name}}){{/if}}</span>{{/if}}
