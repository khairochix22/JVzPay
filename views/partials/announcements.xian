{{#if items.length}}
<section class="card mb">
  <div class="card__header"><div><h2>Announcements</h2></div></div>
  <div class="card__body card__body--flush" style="padding-top:8px">
    <ul class="list">
      {{#each items}}<li class="list__item"><span class="dot"></span><div class="list__body"><strong>{{title}}</strong><small>{{body}}</small></div><small class="nowrap">{{date published_at}}</small></li>{{/each}}
    </ul>
  </div>
</section>
{{/if}}
