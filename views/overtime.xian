{{> app_head}}
{{> app_shell_open}}
<div class="page-header">
  <div><h1>Overtime</h1><p>Only overtime approved by an Accounting Supervisor is paid. Rates follow the overtime multipliers in payroll settings.</p></div>
  {{#if (can "overtime.approve")}}<div class="page-actions"><a class="btn btn--secondary" href="/overtime/review">Approval queue</a></div>{{/if}}
</div>

{{#if canSubmit}}
<section class="card mb">
  <div class="card__header"><div><h2>Encode overtime</h2><p>You cannot encode overtime for yourself.</p></div></div>
  <form class="card__body" method="POST" action="/overtime" novalidate>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    {{#if errors.form}}<div class="alert alert--error" role="alert"><svg class="ic"><use href="#i-alert"/></svg><div>{{errors.form}}</div></div>{{/if}}
    <div class="form-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
      <div class="field"><label for="employee_id">Employee <span class="req">*</span></label>
        <select class="select" id="employee_id" name="employee_id" required {{#if errors.employee_id}}aria-invalid="true"{{/if}}><option value="">Select employee</option>{{#each employees}}<option value="{{id}}" {{selected id ../form.employee_id}}>{{name}} ({{employee_no}})</option>{{/each}}</select>
        {{#if errors.employee_id}}<span class="field__error">{{errors.employee_id}}</span>{{/if}}</div>
      {{> field name="work_date" label="Date worked" type="date" required=true value=form.work_date error=errors.work_date}}
      {{> field name="hours" label="Hours" required=true value=form.hours error=errors.hours inputmode="decimal" placeholder="e.g. 2.5"}}
      <div class="field"><label for="ot_type">Type <span class="req">*</span></label>
        <select class="select" id="ot_type" name="ot_type">{{#each types}}<option value="{{this}}" {{selected this ../form.ot_type}}>{{humanize this}}</option>{{/each}}</select>
        <span class="field__hint">Rest day / Holiday use the higher multipliers.</span></div>
      <div class="span-2">{{> field name="reason" label="Reason" required=true value=form.reason error=errors.reason placeholder="e.g. Inventory count after closing"}}</div>
    </div>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Submit for approval</button></div>
  </form>
</section>
{{/if}}

<section class="card">
  <form class="toolbar" method="GET" action="/overtime">
    <div class="input-group search"><svg class="ic"><use href="#i-search"/></svg><label class="sr-only" for="q">Search</label><input class="input" type="search" id="q" name="q" value="{{t.q}}" placeholder="Employee name or ID" data-autosubmit></div>
    <input class="input" style="width:auto" type="date" name="from" value="{{from}}" aria-label="From date"><input class="input" style="width:auto" type="date" name="to" value="{{to}}" aria-label="To date">
    <select class="select" name="status" aria-label="Status" data-autosubmit>{{#each (array "all" "pending" "approved" "rejected")}}<option value="{{this}}" {{selected this ../status}}>{{humanize this}}</option>{{/each}}</select>
    <button class="btn btn--secondary" type="submit">Apply</button>
    <span class="toolbar__spacer"></span><span class="muted" style="font-size:13px">{{fixed totals.hours 2}} h total · {{totals.pending}} pending</span>
  </form>
  {{#if rows.length}}
  <div class="table-wrap"><table class="table table--stack">
    <thead><tr>{{sortTh meta "date" "Date"}}{{sortTh meta "employee" "Employee"}}<th class="text-right">Hours</th><th>Type</th><th>Reason</th><th>Status</th><th>Decision</th></tr></thead>
    <tbody>{{#each rows}}<tr>
      <td data-label="Date" class="nowrap">{{date work_date}}</td>
      <td class="cell-primary"><strong>{{name}}</strong><br><span class="muted">{{employee_no}} · encoded by {{submitted_by_name}}</span></td>
      <td data-label="Hours" class="text-right num">{{fixed hours 2}}</td>
      <td data-label="Type">{{humanize ot_type}}</td>
      <td data-label="Reason">{{reason}}</td>
      <td data-label="Status"><div>{{badge status}}{{#if payroll_record_id}}<br><span class="muted" style="font-size:12px">Paid</span>{{/if}}</div></td>
      <td data-label="Decision"><div>{{#if decided_at}}{{decided_by_name}}<br><span class="muted" style="font-size:12px">{{date decided_at}}{{#if decision_remarks}} · “{{decision_remarks}}”{{/if}}</span>{{else}}<span class="muted">—</span>{{/if}}</div></td>
    </tr>{{/each}}</tbody>
  </table></div>
  {{> pager meta=meta}}
  {{else}}<div class="empty"><svg class="ic"><use href="#i-trending-up"/></svg><strong>No overtime records</strong>Nothing in the selected range.</div>{{/if}}
</section>
{{> app_shell_close}}
