{{> app_head}}
<div class="auth">
  {{#> auth_hero headline="Smart Accounting." headline2="Efficient Payroll." lead="A modern solution for managing payroll, attendance, leave and finances in one secure place."}}
  <ul class="auth__points">
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-key"/></svg></span><span>Reset links work once</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-clock"/></svg></span><span>They expire after a short time</span></li>
    <li><span class="auth__point-ic"><svg class="ic"><use href="#i-shield"/></svg></span><span>Every reset is recorded in the audit trail</span></li>
  </ul>
  {{/auth_hero}}

  <main class="auth__panel">
    <div class="auth__card">
      <div class="auth__mobile-brand"><img class="auth__logo" src="/img/johnvivz-logo-trim.png" alt="JohnVivz" width="120" height="65"><span>JVzPay<small>Manage · Pay · Grow</small></span></div>
      {{#if invalid}}
      <div class="auth__head auth__head--left"><h1>This link no longer works</h1></div>
      <div class="alert alert--warning" role="alert"><svg class="ic"><use href="#i-alert"/></svg><div>Password reset links work once and expire after a short time. Ask your Accounting Supervisor for a new one.</div></div>
      <a class="btn btn--secondary btn--block" href="/login">Back to sign in</a>
      {{else}}
      <div class="auth__head auth__head--left">
        <h1>Choose a new password</h1>
        <p>For <strong>{{email}}</strong>. This link works once and expires at {{datetime expiresAt}}.</p>
      </div>
      <form method="POST" action="/reset-password/{{token}}" novalidate>
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="form-grid">
          {{> field fieldIcon="lock" reveal=true name="new_password" label="New password" type="password" required=true error=errors.new_password autocomplete="new-password" hint="At least 10 characters, with letters and numbers."}}
          {{> field fieldIcon="lock" reveal=true name="confirm_password" label="Confirm new password" type="password" required=true error=errors.confirm_password autocomplete="new-password"}}
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg" style="margin-top:20px">Set password</button>
      </form>
      {{/if}}
    </div>
  </main>
</div>
<script src="/js/app.js"></script>
</body>
</html>
