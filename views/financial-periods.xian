{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>Financial Periods</h1><p>Months are created automatically on first posting. A closed month accepts no further entries.</p></div></div>
<section class="card">{{#if periods.length}}
  <div class="table-wrap"><table data-table-tools class="table table--stack"><thead><tr><th>Period</th><th class="text-right">Entries</th><th class="text-right">Pending</th><th>Status</th><th>Closed by</th>{{#if canManage}}<th class="actions"><span class="sr-only">Actions</span></th>{{/if}}</tr></thead>
    <tbody>{{#each periods}}<tr>
      <td class="cell-primary"><strong>{{label}}</strong><br><span class="muted">{{date start_date}} – {{date end_date}}</span></td>
      <td data-label="Entries" class="text-right num">{{entries}}</td><td data-label="Pending" class="text-right num">{{pending}}</td><td data-label="Status">{{badge status}}</td><td data-label="Closed by">{{default closed_by_name "—"}}</td>
      {{#if ../canManage}}<td class="actions"><form method="POST" action="/accounting/periods/{{id}}/{{#if (eq status "open")}}close{{else}}reopen{{/if}}" data-confirm="{{#if (eq status "open")}}Close{{else}}Reopen{{/if}} {{label}}?" data-confirm-label="Confirm"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="btn btn--ghost btn--sm" type="submit">{{#if (eq status "open")}}Close{{else}}Reopen{{/if}}</button></form></td>{{/if}}
    </tr>{{/each}}</tbody></table></div>
  {{else}}<div class="empty"><svg class="ic"><use href="#i-calendar"/></svg><strong>No financial periods yet</strong>They appear when the first entry is posted.</div>{{/if}}</section>
{{> app_shell_close}}
