{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>Change password</h1><p class="muted" style="margin-top:4px">Account: <strong>{{me.email}}</strong></p><p>{{#if forced}}You must choose a new password before continuing.{{else}}Choose a strong password you do not use anywhere else.{{/if}}</p></div></div>

{{#if forced}}<div class="alert alert--warning"><svg class="ic"><use href="#i-lock"/></svg><div>Your account was issued with a temporary password. Set a new one to continue.</div></div>{{/if}}

<div class="card" style="max-width:560px">
  <form class="card__body" method="POST" action="/account/password" novalidate>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="form-grid">
      <div class="field">
        <label for="current_password">Current password <span class="req">*</span></label>
        <input class="input" type="password" id="current_password" name="current_password" autocomplete="current-password" required {{#if errors.current_password}}aria-invalid="true"{{/if}}>
        {{#if errors.current_password}}<span class="field__error">{{errors.current_password}}</span>{{/if}}
      </div>
      <div class="field">
        <label for="new_password">New password <span class="req">*</span></label>
        <input class="input" type="password" id="new_password" name="new_password" autocomplete="new-password" required minlength="10" {{#if errors.new_password}}aria-invalid="true"{{/if}}>
        <span class="field__hint">At least 10 characters with letters and numbers.</span>
        {{#if errors.new_password}}<span class="field__error">{{errors.new_password}}</span>{{/if}}
      </div>
      <div class="field">
        <label for="confirm_password">Confirm new password <span class="req">*</span></label>
        <input class="input" type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required {{#if errors.confirm_password}}aria-invalid="true"{{/if}}>
        {{#if errors.confirm_password}}<span class="field__error">{{errors.confirm_password}}</span>{{/if}}
      </div>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn--primary">Update password</button></div>
  </form>
</div>
{{> app_shell_close}}
