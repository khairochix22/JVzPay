{{> app_head}}
{{> app_shell_open}}
<div class="page-header"><div><h1>Withholding Tax Table</h1><p>Graduated annual table: tax = base + rate × (annual taxable − bracket start). The table effective on the period's end date is used.</p></div></div>
{{#each tables}}
<section class="card mb">
  <div class="card__header">
    <div><h2>Effective {{date effective_from}}{{#if effective_to}} – {{date effective_to}}{{/if}}</h2><p>{{source_reference}}</p></div>
    {{#if is_verified}}<div>{{badge "verified"}} <span class="muted" style="font-size:12px">{{verified_by_name}}</span></div>
    {{else}}<form method="POST" action="/payroll/setup/tax/verify" data-confirm="Confirm you checked this table against the current BIR issuance." data-confirm-label="Mark verified"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><input type="hidden" name="effective_from" value="{{inputDate effective_from}}"><button class="btn btn--primary btn--sm" type="submit">Verify table</button></form>{{/if}}
  </div>
  <div class="table-wrap" style="margin-top:10px"><table data-table-tools class="table">
    <thead><tr><th class="text-right">Annual income from</th><th class="text-right">Up to</th><th class="text-right">Base tax</th><th class="text-right">Rate on excess</th></tr></thead>
    <tbody>{{#each brackets}}<tr><td class="text-right num">{{money annual_from}}</td><td class="text-right num">{{#if annual_to}}{{money annual_to}}{{else}}No limit{{/if}}</td><td class="text-right num">{{money base_tax}}</td><td class="text-right num">{{pct rate}}</td></tr>{{/each}}</tbody>
  </table></div>
</section>
{{/each}}
<details class="card"><summary class="card__body" style="cursor:pointer;font-weight:600;color:var(--primary)">Add a new tax table version</summary>
  <form class="card__body" method="POST" action="/payroll/setup/tax" novalidate>
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div class="form-grid" style="margin-bottom:14px">
      {{> field name="effective_from" label="Effective from" type="date" required=true}}
      {{> field name="source_reference" label="Source (law / BIR issuance)" required=true}}
    </div>
    <div class="table-wrap"><table data-table-tools class="table"><thead><tr><th>From</th><th>Up to (blank on the last)</th><th>Base tax</th><th>Rate %</th></tr></thead>
      <tbody>{{#each blankRows}}<tr>
        <td><input class="input" name="rows[r{{this}}][annual_from]" inputmode="decimal" aria-label="From"></td><td><input class="input" name="rows[r{{this}}][annual_to]" inputmode="decimal" aria-label="Up to"></td>
        <td><input class="input" name="rows[r{{this}}][base_tax]" inputmode="decimal" aria-label="Base tax"></td><td><input class="input" name="rows[r{{this}}][rate_pct]" inputmode="decimal" aria-label="Rate percent"></td>
      </tr>{{/each}}</tbody></table></div>
    <p class="field__hint" style="margin-top:8px">Each bracket must start where the previous ends; the first starts at 0. Leave unused rows empty.</p>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Add table</button></div>
  </form>
</details>
{{> app_shell_close}}
