{{> app_head}}
{{> app_shell_open}}
<section class="welcome">
  <div><h1>Hello, {{welcomeName}}</h1><p>Your payroll preparation workspace.</p></div>
  <div class="welcome__meta">
    {{#if d.period}}<strong>Current period: {{d.period.label}}</strong>{{date d.period.start_date}} – {{date d.period.end_date}}{{else}}<strong>No open payroll period</strong><a href="/payroll" style="color:#fff;text-decoration:underline">See Payroll</a>{{/if}}
  </div>
</section>

{{> announcements items=d.announcements}}

<div class="grid grid--kpi">
  {{#each d.kpis}}{{> kpi}}{{/each}}
</div>

<div class="grid grid--main-side">
  <div>
    {{> chart_card title="Attendance validation" subtitle="Last 31 days · share of records by validation state" config=d.cfg.validation segments=true emptyText="Attendance records awaiting validation will appear here."}}
    <section class="card" style="margin-top:22px">
      <div class="card__header"><div><h2>Quick actions</h2></div></div>
      <div class="card__body"><div class="quick">
        <a href="/attendance/encode"><svg class="ic"><use href="#i-edit"/></svg>Encode attendance</a>
        <a href="/attendance/validation"><svg class="ic"><use href="#i-check-circle"/></svg>Validate attendance</a>
        <a href="/overtime"><svg class="ic"><use href="#i-trending-up"/></svg>Encode overtime</a>
        <a href="/payroll"><svg class="ic"><use href="#i-calendar"/></svg>Payroll</a>
        <a href="/attendance/validation"><svg class="ic"><use href="#i-check-circle"/></svg>Validate attendance</a>
      </div></div>
    </section>
  </div>
  {{> activity_list title="Recent payroll activities" subtitle="Payroll, attendance and overtime" items=d.activity}}
</div>

{{> dashboard_panels p=panels}}
<script src="/vendor/chartjs/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>
{{> app_shell_close}}
