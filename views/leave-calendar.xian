{{> app_head}}
{{> app_shell_open}}
<div class="page-header">
  <div><h1>Leave Calendar</h1><p>Approved and pending leave by day. Pending leave is shown outlined.</p></div>
</div>
<div class="card mb" style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;gap:10px;flex-wrap:wrap">
  <a class="btn btn--ghost btn--sm" href="/leave-calendar?month={{prev}}{{#if department}}&department={{department}}{{/if}}"><svg class="ic ic--sm"><use href="#i-chevron-left"/></svg>Previous</a>
  <strong style="color:var(--primary)">{{label}}</strong>
  <form method="GET" action="/leave-calendar" style="display:flex;gap:8px"><input type="hidden" name="month" value="{{month}}">
    <select class="select" name="department" aria-label="Department" data-autosubmit style="min-height:36px"><option value="">All departments</option>{{#each departments}}<option value="{{id}}" {{selected id ../department}}>{{name}}</option>{{/each}}</select></form>
  <a class="btn btn--ghost btn--sm" href="/leave-calendar?month={{next}}{{#if department}}&department={{department}}{{/if}}">Next<svg class="ic ic--sm"><use href="#i-chevron-right"/></svg></a>
</div>

<section class="card cal-card">
  <div class="cal" role="table" aria-label="Leave calendar for {{label}}">
    <div class="cal__row cal__head" role="row">{{#each (array "Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat")}}<div role="columnheader">{{this}}</div>{{/each}}</div>
    {{#each weeks}}
    <div class="cal__row" role="row">
      {{#each this}}
        {{#if this}}
        <div class="cal__day {{#if today}}is-today{{/if}} {{#if rest}}is-rest{{/if}} {{#if holiday}}is-holiday{{/if}}" role="cell">
          <div class="cal__num">{{day}}</div>
          {{#if holiday}}<div class="cal__hol">{{holiday}}</div>{{/if}}
          {{#each items}}<a class="cal__chip {{#if (eq status "pending")}}is-pending{{/if}}" href="/leave-requests/{{id}}" title="{{who}} — {{type_name}} ({{status}})">{{who}} · {{code}}</a>{{/each}}
        </div>
        {{else}}<div class="cal__day is-blank" role="cell"></div>{{/if}}
      {{/each}}
    </div>
    {{/each}}
  </div>
</section>

<section class="card" style="margin-top:22px">
  <div class="card__header"><div><h2>List view</h2><p>{{apps.length}} application(s) touching {{label}}</p></div></div>
  <div class="card__body card__body--flush">
    {{#if apps.length}}<ul class="list">{{#each apps}}<li class="list__item"><span class="dot"></span><div class="list__body"><strong><a href="/leave-requests/{{id}}">{{first_name}} {{last_name}}</a> · {{type_name}}</strong><small>{{date start_date}}{{#if (ne start_date end_date)}} – {{date end_date}}{{/if}} · {{fixed days 1}} day(s)</small></div>{{badge status}}</li>{{/each}}</ul>
    {{else}}<div class="empty empty--sm">No leave this month.</div>{{/if}}
  </div>
</section>
{{> app_shell_close}}
