# Laptop / development settings. For the AWS server use .env.production.example (docs/DEPLOY-AWS.md).
NODE_ENV=development
PORT=3002
# Empty = listen on every address (the other JOHNVIVZ laptops on the Wi-Fi can reach you). Server: 127.0.0.1
HOST=
# Empty = links (password reset, registration) use the address the browser used. Server: https://johnvivz-pay.duckdns.org
PUBLIC_BASE_URL=
# false on a laptop (no proxy). Server behind Nginx: 1
TRUST_PROXY=false
# false so sign-in works over http on a laptop. Server: true once https:// works
COOKIE_SECURE=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=JVzPay
DB_USER=root
DB_PASSWORD=

# openssl rand -hex 48
SESSION_SECRET=
# openssl rand -hex 32  (64 hex chars). Back this up: losing it makes encrypted bank/government IDs unrecoverable.
DATA_ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=30
MAX_FAILED_LOGINS=3
# One-time password reset links expire after this many minutes
RESET_LINK_MINUTES=30
# Serve HTTPS directly (PEM files). Leave empty when a proxy such as Apache/nginx handles TLS.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
# With HTTPS on, also listen here and redirect plain HTTP to HTTPS (0 = off)
HTTP_REDIRECT_PORT=0
# Optional: separate key for sealing the audit trail (defaults to one derived from DATA_ENCRYPTION_KEY)
AUDIT_SEAL_KEY=
# 1 = do not run the minute-by-minute audit sealing and the daily backup/clean-up (automated tests only)
DISABLE_SCHEDULER=0
# Optional folders (defaults: storage/backups, storage/uploads) and MySQL tool paths (default: Laragon, then PATH)
BACKUP_DIR=
UPLOAD_DIR=
MYSQL_PATH=
MYSQLDUMP_PATH=
LOCKOUT_MINUTES=15

COMPANY_NAME=JohnVivz Grocery Store
COMPANY_ADDRESS=Bongabong, Oriental Mindoro, Philippines

ADMIN_EMAIL=admin@johnvivz.local
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=

# Integration (docs/API_INTEGRATION.md §1, §3, §6).
# Calling another app: its base address WITHOUT the API path (e.g. http://192.168.1.20:3001), the API path it serves
# (default /api/v1; the CRM integration contract uses /api/integration/v1), and how JVzPay proves who it is:
# *_API_SECRET = shared secret for signed X-JVZ-* headers (contract §2), and/or *_API_TOKEN = bearer token that app gave you.
# Leave the URL empty until that app is running.
# HR is pull-only (team decision 2026-11-16): JVzPay reads it every 15 minutes and asks it to confirm each ESS
# registration; HR_API_TOKEN = the API key HR created for Accounting. No HR = no registration (no offline registration).
HR_API_URL=
HR_API_PREFIX=/api/integration/v1
HR_API_SECRET=
HR_API_TOKEN=
# HR has no /events endpoint, so nothing is queued for it (default false)
HR_EVENTS_ENABLED=false
# HR's approved compensation of one employee ({identifier} = the JV number)
HR_COMPENSATION_PATH=/payroll/employees/{identifier}/compensation
CRM_API_URL=
CRM_API_PREFIX=/api/integration/v1
CRM_API_SECRET=
CRM_API_TOKEN=
# Inventory keeps its events in an outbox that JVzPay polls every minute; INVENTORY_API_TOKEN = the token Inventory gave you
INVENTORY_API_URL=
INVENTORY_API_PREFIX=/api/integration/v1
INVENTORY_API_SECRET=
INVENTORY_API_TOKEN=
INVENTORY_POLL_ENABLED=true
# Queue events for CRM / Inventory (default true; HR_EVENTS_ENABLED above defaults to false)
CRM_EVENTS_ENABLED=true
INVENTORY_EVENTS_ENABLED=true
# Production only: apps whose server is not ready yet (hr, crm, inventory) are not required at start-up
PENDING_INTEGRATIONS=
# Department login (POST /api/integration/v1/auth/login): HR's department codes that count as CRM's / Inventory's staff
CRM_DEPARTMENT_CODES=CRM
INVENTORY_DEPARTMENT_CODES=INVENTORY

# Organisation (lib/orgSettings.js), following HR's position titles:
# HR's code of the Payroll/Accounting department
ACCOUNTING_DEPARTMENT_CODE=PAYROLL_ACCOUNTING
# Payroll/Accounting titles that get a JVzPay role (every other title, and every other department, gets "employee")
POSITION_ROLES=Accounting Supervisor=accounting_supervisor,Accounting Staff=accounting_staff,Payroll Staff=payroll_staff
# Each department's supervisors/managers, highest first: they approve first when HR names no immediate supervisor
DEPARTMENT_SUPERVISOR_TITLES=CRM=CRM Manager|Team Leader;INVENTORY=Inventory Manager|Inventory Supervisor;HR=HR Manager|HR Supervisor;PAYROLL_ACCOUNTING=Accounting Supervisor
# Another app calling JVzPay with signed X-JVZ-* headers: the shared secret for THAT app (a different secret per app and
# per direction; CRM calls its copy JVZ_SECRET_ACCOUNTING). Apps can instead use a bearer token from System → Integration.
# openssl rand -hex 32
HR_INBOUND_SECRET=
CRM_INBOUND_SECRET=
INVENTORY_INBOUND_SECRET=
