NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=JVzPay
DB_USER=root
DB_PASSWORD=

# openssl rand -hex 48
SESSION_SECRET=
# openssl rand -hex 32  (64 hex chars). Back this up: losing it makes encrypted bank/government IDs unrecoverable.
DATA_ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=30
MAX_FAILED_LOGINS=3
# One-time password reset links expire after this many minutes
RESET_LINK_MINUTES=30
# Serve HTTPS directly (PEM files). Leave empty when a proxy such as Apache/nginx handles TLS.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
# With HTTPS on, also listen here and redirect plain HTTP to HTTPS (0 = off)
HTTP_REDIRECT_PORT=0
# Optional: separate key for sealing the audit trail (defaults to one derived from DATA_ENCRYPTION_KEY)
AUDIT_SEAL_KEY=
# 1 = do not run the minute-by-minute audit sealing and the daily backup/clean-up (automated tests only)
DISABLE_SCHEDULER=0
LOCKOUT_MINUTES=15

COMPANY_NAME=JohnVivz Grocery Store
COMPANY_ADDRESS=Bongabong, Oriental Mindoro, Philippines

ADMIN_EMAIL=admin@johnvivz.local
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=

# Integration (docs/API_INTEGRATION.md §3, §6). Base address of each application WITHOUT /api/v1, and the token that
# application created for JVzPay. Leave the URL empty until that app is running: events wait as "not connected".
# Local example: HR_API_URL=http://localhost:3001
HR_API_URL=
HR_API_TOKEN=
CRM_API_URL=
CRM_API_TOKEN=
INVENTORY_API_URL=
INVENTORY_API_TOKEN=
