# =====================================================================================================================
# JVzPay (JOHNVIVZ Accounting & Payroll + Employee Self-Service) — PRODUCTION settings for the AWS EC2 server.
#
#   cp .env.production.example .env        or, for a BRAND-NEW database:   npm run setup -- --production
#   chmod 600 .env                         (fills SESSION_SECRET and DATA_ENCRYPTION_KEY with fresh random values)
#
# This file holds NO real secrets. Every empty secret must be filled in on the server, in .env only — never commit .env.
# With NODE_ENV=production the app REFUSES TO START when a required value is missing, a secret is shorter than
# 32 characters (SESSION_SECRET: 64, DB_PASSWORD: 16), still a placeholder, or the same as another secret
# (config/productionCheck.js). The error message names the variable. Step-by-step guide: docs/DEPLOY-AWS.md.
#
# Who provides it:  [US] = we generate it here   [HR] / [CRM] / [INVENTORY] = that team gives it to us privately
#                   [BOTH] = agreed with that team (one side generates it, both keep a copy)
# Never send a secret in a group chat or commit it. Restart after every change: pm2 restart jvzpay --update-env
# =====================================================================================================================

# ---- The web server (behind Nginx) -----------------------------------------------------------------------------------
NODE_ENV=production
# JVzPay's agreed port. Nginx forwards https://johnvivz-pay.duckdns.org to 127.0.0.1:3002.
PORT=3002
# Listen on the loopback address only, so port 3002 cannot be reached from the internet past Nginx. Required: 127.0.0.1
HOST=127.0.0.1
# [US] Public address of this server, without a trailing slash or path. Password reset links and the employee
# registration link (https://johnvivz-pay.duckdns.org/register/employee) are built from it. Required, https://.
PUBLIC_BASE_URL=https://johnvivz-pay.duckdns.org
# One Nginx in front: take the visitor's address and https from X-Forwarded-For / X-Forwarded-Proto.
# Used by sign-in rate limits, the audit log, sign-in history and secure cookies. Use 1 (true = 1). Default false.
TRUST_PROXY=1
# Send the session cookie only over https. Leave false until `sudo certbot --nginx` succeeded and
# https://johnvivz-pay.duckdns.org opens; then set true and restart. Default false (so a laptop on http still works).
COOKIE_SECURE=false
# TLS is done by Nginx + Let's Encrypt. These MUST stay empty on the server (the app refuses to start otherwise).
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
HTTP_REDIRECT_PORT=0

# ---- Database (MySQL 8.4 on this same instance) ----------------------------------------------------------------------
# 127.0.0.1, not "localhost": Node may try ::1 (IPv6) first, which MySQL on Ubuntu does not listen on.
DB_HOST=127.0.0.1
DB_PORT=3306
# Exactly "JVzPay": on Linux, database and table names are case-sensitive (JVzPay and jvzpay are different databases).
DB_NAME=JVzPay
# [US] The MySQL user that can reach ONLY the JVzPay database (docs/DEPLOY-AWS.md §3). Never root.
DB_USER=jvzpay
# [US] That user's password, at least 16 characters. Generate: openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=

# ---- Secrets of this application [US] --------------------------------------------------------------------------------
# Signs the sign-in cookies. 64+ characters. Generate: openssl rand -hex 48
# Changing it signs everybody out (nothing else is lost).
SESSION_SECRET=
# Encrypts bank account numbers and SSS / PhilHealth / Pag-IBIG / TIN numbers (AES-256-GCM). 64 hex characters.
# Generate ONCE for a new database: openssl rand -hex 32
# !! BACK IT UP SEPARATELY FROM THE DATABASE BACKUPS (password manager / printed in a safe; docs/DEPLOY-AWS.md §9).
# !! LOSING IT MAKES EVERY STORED BANK AND GOVERNMENT ID NUMBER UNREADABLE FOREVER. A database backup is useless
# !! for those fields without this exact key. Never regenerate it for an existing database. Required: the app
# !! refuses to start without it, or when it cannot decrypt the numbers already in the database.
DATA_ENCRYPTION_KEY=
# Optional: separate key that seals the audit trail. Empty = derived from DATA_ENCRYPTION_KEY. If set: openssl rand -hex 32
# (and back it up with DATA_ENCRYPTION_KEY: changing it makes the audit seals of older records fail verification).
AUDIT_SEAL_KEY=

# ---- Sign-in policy --------------------------------------------------------------------------------------------------
# Idle minutes before a signed-in user is signed out
SESSION_IDLE_MINUTES=30
# Wrong passwords in a row before the account locks, and for how many minutes
MAX_FAILED_LOGINS=3
LOCKOUT_MINUTES=15
# One-time password reset links expire after this many minutes
RESET_LINK_MINUTES=30

# ---- Company (printed on payslips and reports) -----------------------------------------------------------------------
COMPANY_NAME=JohnVivz Grocery Store
COMPANY_ADDRESS=Bongabong, Oriental Mindoro, Philippines

# ---- First Accounting Supervisor (used ONCE by `npm run seed`) -------------------------------------------------------
# Do not keep a password here. Give it on the command line once (docs/DEPLOY-AWS.md §6), or put it here for the seed
# and delete the line right after. The account must change its password at first sign-in.
ADMIN_EMAIL=
ADMIN_NAME=Accounting Supervisor
ADMIN_PASSWORD=

# ---- Background jobs -------------------------------------------------------------------------------------------------
# 0 = on (production). The jobs run inside the ONE PM2 process: payroll computation (hourly), HR pull (15 min),
# Inventory outbox poll (1 min), event delivery and audit sealing (1 min), daily backup + retention clean-up.
# 1 = off: only for automated tests.
DISABLE_SCHEDULER=0

# ---- Files on disk (defaults shown; outside the app folder survives a fresh clone) -------------------------------------
# Automatic daily backups made by the app (Backup & Maintenance page). Default: <app>/storage/backups
BACKUP_DIR=/var/lib/jvzpay/backups
# Uploaded documents (bank proofs, leave attachments...). Default: <app>/storage/uploads. Back this folder up too.
UPLOAD_DIR=/var/lib/jvzpay/uploads
# Full paths of the MySQL client tools, only if `mysql` / `mysqldump` are not on the PATH (on Ubuntu they are).
MYSQL_PATH=
MYSQLDUMP_PATH=

# ---- Email (NOT USED by this version: password reset links are handed over by the Accounting Supervisor) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- The other JOHNVIVZ applications (only over HTTPS, through /api/integration/v1) -------------------------------------
# Applications whose server is not ready yet, comma-separated (hr, crm, inventory). Their settings are then not
# required. Temporary: the app warns at every start. Empty when all four servers run.
PENDING_INTEGRATIONS=

# HR (https://johnvivz-hr.duckdns.org) — pull-only: JVzPay reads employees, departments and approved pay every
# 15 minutes ("Sync now" on System > Integration) and asks HR to confirm each employee registration.
# Base address only, no path. Required.
HR_API_URL=https://johnvivz-hr.duckdns.org
# The API path HR serves. Required.
HR_API_PREFIX=/api/integration/v1
# [HR] The API key HR created for Accounting (HR's admin screen), sent as "Authorization: Bearer". Required.
HR_API_TOKEN=
# [BOTH] Optional: only if HR also checks signed X-JVZ-* requests. openssl rand -hex 32
HR_API_SECRET=
# HR has no /events endpoint: keep false (nothing is queued for HR).
HR_EVENTS_ENABLED=false
# HR's approved compensation of one employee ({identifier} = the JV employee number)
HR_COMPENSATION_PATH=/payroll/employees/{identifier}/compensation
# [BOTH] Optional: only if HR calls JVzPay with signed X-JVZ-* requests (otherwise HR uses a token from
# System > Integration). openssl rand -hex 32; HR keeps the same value.
HR_INBOUND_SECRET=

# CRM (https://johnvivz-crm.duckdns.org, already live) — signed X-JVZ-* requests both ways (CRM contract v0.4.1 §2).
CRM_API_URL=https://johnvivz-crm.duckdns.org
CRM_API_PREFIX=/api/integration/v1
# [BOTH] JVzPay signs its calls TO CRM with this (CRM's name: JVZ_CRM_INBOUND_SECRET_ACCOUNTING). Required.
# openssl rand -hex 32 — must differ from CRM_INBOUND_SECRET.
CRM_API_SECRET=
# [BOTH] CRM signs its calls TO JVzPay (sales events, department login) with this (CRM's name: JVZ_SECRET_ACCOUNTING).
# Required. openssl rand -hex 32
CRM_INBOUND_SECRET=
# [CRM] Optional: a bearer token CRM gave JVzPay, if CRM also wants one.
CRM_API_TOKEN=
# Queue events for CRM (default true). JVzPay sends CRM nothing today.
CRM_EVENTS_ENABLED=true

# Inventory (https://johnvivz-inventory.duckdns.org) — JVzPay reads Inventory's outbox every minute:
#   GET  {INVENTORY_API_URL}{INVENTORY_API_PREFIX}/accounting/outbox?limit=100
#   POST {INVENTORY_API_URL}{INVENTORY_API_PREFIX}/accounting/outbox/{event_id}/ack
# i.e. the outbox URL is https://johnvivz-inventory.duckdns.org/api/integration/v1/accounting/outbox
INVENTORY_API_URL=https://johnvivz-inventory.duckdns.org
INVENTORY_API_PREFIX=/api/integration/v1
# [INVENTORY] The token Inventory created for JVzPay to read its outbox ("Authorization: Bearer"). Required. Must not
# be any CRM or HR credential.
INVENTORY_API_TOKEN=
# Read the outbox every minute (true) — false stops the poll
INVENTORY_POLL_ENABLED=true
# [BOTH] Optional: only if Inventory checks signed X-JVZ-* requests from JVzPay. openssl rand -hex 32
INVENTORY_API_SECRET=
# [BOTH] Optional: only if Inventory calls JVzPay with signed requests (otherwise it uses a token from
# System > Integration for the department login). openssl rand -hex 32
INVENTORY_INBOUND_SECRET=
# Queue events for Inventory (default true)
INVENTORY_EVENTS_ENABLED=true

# ---- Organisation (follows HR's codes and position titles; lib/orgSettings.js) -----------------------------------------
# HR department codes whose employees sign in to CRM / Inventory (POST /api/integration/v1/auth/login)
CRM_DEPARTMENT_CODES=CRM
INVENTORY_DEPARTMENT_CODES=INVENTORY
# HR's code of the Payroll/Accounting department
ACCOUNTING_DEPARTMENT_CODE=PAYROLL_ACCOUNTING
# Payroll/Accounting titles that get a JVzPay role (every other title, and every other department, gets "employee")
POSITION_ROLES=Accounting Supervisor=accounting_supervisor,Accounting Staff=accounting_staff,Payroll Staff=payroll_staff
# Each department's supervisors/managers, highest first: they approve first when HR names no immediate supervisor
DEPARTMENT_SUPERVISOR_TITLES=CRM=CRM Manager|Team Leader;INVENTORY=Inventory Manager|Inventory Supervisor;HR=HR Manager|HR Supervisor;PAYROLL_ACCOUNTING=Accounting Supervisor
